POSTGRES_USER=copilot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=domain_copilot
POSTGRES_CONNECTION_STRING=Host=localhost;Port=5432;Database=domain_copilot;Username=copilot;Password=change_me
LLM_API_KEY=
LLM_PROVIDER=gemini
# Where the Ollama fallback lives. Docker reaches a host-installed Ollama via
# host.docker.internal; local `dotnet run` uses the code default (localhost:11434).
OLLAMA_BASE_URL=http://host.docker.internal:11434
PdfOcr__TesseractExecutablePath=
PdfOcr__PdfToPpmExecutablePath=
# Optional: set current provider pricing per one million tokens to calculate EstimatedCostUsd.
# LlmTelemetry__GeminiInputCostPerMillionTokensUsd=
# LlmTelemetry__GeminiOutputCostPerMillionTokensUsd=
